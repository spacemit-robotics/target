{
  "version": "1.0",
  "board": "k3-com260",
  "product": "unitree-go2",
  "description": "Go2 ROS 2 application with Linux CPU inference and external SDK components",
  "enabled_packages": [
    "components/model_zoo/rl",
    "components/peripherals/motor",
    "components/peripherals/imu",
    "components/peripherals/rc_receiver",
    "components/peripherals/led",
    "application/ros2/unitree-go2"
  ],
  "enabled_package_options": {
    "components/peripherals/motor": {
      "enabled_drivers": [
        "drv_485_m8010a"
      ]
    },
    "components/peripherals/imu": {
      "enabled_drivers": [
        "drv_spi_bmi270",
        "drv_uart_iwt603"
      ]
    },
    "components/peripherals/rc_receiver": {
      "enabled_drivers": [
        "drv_uart_sbus"
      ]
    },
    "components/peripherals/led": {
      "enabled_drivers": [
        "drv_pwm_sysfs"
      ]
    }
  },
  "options": {
    "parallel_jobs": 4,
    "auto_resolve_dependencies": true
  }
}
